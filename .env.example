APP_NAME=DataForge
APP_ENV=development
DEBUG=false

# Local-only database credentials. Replace them before deployment.
POSTGRES_DB=dataforge
POSTGRES_USER=dataforge_user
POSTGRES_PASSWORD=dataforge_password
POSTGRES_PORT=5434
DATABASE_URL=postgresql+asyncpg://dataforge_user:dataforge_password@localhost:5434/dataforge

# Generate a unique secret with: openssl rand -hex 32
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

API_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set these to DNS names pointing at the deployment host to enable Caddy TLS.
APP_DOMAIN=localhost
API_DOMAIN=api.localhost
